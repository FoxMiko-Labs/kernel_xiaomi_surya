# CONFIG_ARCH_SM6150 is not set
# CONFIG_HZ_100 is not set
CONFIG_HZ_300=y
# CONFIG_MMC_PERF_PROFILING is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MSM_CAMCC_SM6150 is not set
# CONFIG_MSM_DISPCC_SM6150 is not set
# CONFIG_MSM_GCC_SM6150 is not set
# CONFIG_MSM_GPUCC_SM6150 is not set
# CONFIG_MSM_SCC_SM6150 is not set
# CONFIG_MSM_VIDEOCC_SM6150 is not set
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_QCA_CLD_WLAN=y
